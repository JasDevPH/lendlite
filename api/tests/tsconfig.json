{
  // Type-checks the tests (ts-jest uses this too). Adds Jest's global types.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "rootDir": "..",
    "noEmit": true,
    "types": ["node", "jest"],
    // ts-jest compiles each file on its own (faster, required with node16 modules).
    // Type errors are caught by `npm run typecheck`, which includes this project.
    "isolatedModules": true
  },
  "include": ["./**/*.ts", "../src/types/**/*.d.ts"],
  // Override, don't inherit: the root config's exclude contains "tests" (resolved
  // relative to the ROOT), which silently excluded every test file from this project
  "exclude": ["../node_modules", "../dist"]
}

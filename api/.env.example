NODE_ENV=development
PORT=4001
# Local Docker default (`docker compose up -d db`, host port 5433).
# For Neon, run `npm run db:neon` to fill this in.
DATABASE_URL=postgresql://lendlite:lendlite@localhost:5433/lendlite
# Generate a real one with `npm run secret:jwt -- --write`
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1h
WEB_ORIGIN=http://localhost:3000
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# Reverse proxies in front of the API (set 1 on Railway)
TRUST_PROXY=0

# File storage: "local" (UPLOAD_DIR, dev) or "cloudinary" (production)
STORAGE_DRIVER=local
# Cloudinary dashboard → API Keys → "API environment variable". Never commit the real one.
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_FOLDER=lendlite/documents
